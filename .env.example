# Use TMDB API Read Access Token (bearer), NOT v3 API key.
TMDB_READ_TOKEN=
# Local secret is generated automatically. For deployment, set a strong secret.
# SECRET_KEY=
# Local uses SQLite automatically; deployment requires PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/database
APP_ENV=development

# Optional private analytics: YOUR existing account ID from My library.
# Set separately on Render using the ID from your LIVE account; no default owner.
# ADMIN_USER_ID=
